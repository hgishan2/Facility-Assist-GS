    match /utility_readings/{readingId} {
      allow get: if isValidId(readingId) && (
        isAdmin()
        || (isSupervisor() && callerEmail() in existing().supervisorEmails)
        || (isAuthIdentity() && (existing().technicianUid == request.auth.uid || existing().technicianEmail == callerEmail()))
      );
      allow list: if isRootAdminEmail()
        || (isAuthIdentity() && (
          callerEmail() in resource.data.supervisorEmails
          || resource.data.technicianUid == request.auth.uid
          || resource.data.technicianEmail == callerEmail()
        ));
      allow create: if isValidId(readingId)
        && isAuthIdentity()
        && isValidUtilityReading(incoming())
        && incoming().id == readingId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/buildings/$(incoming().buildingId))
        && (
          isAdmin()
          || (isSupervisor() && ownsBuildingDoc(incoming().buildingId))
          || (
            isTechnician()
            && isBuildingMemberDoc(incoming().buildingId)
            && incoming().technicianUid == request.auth.uid
            && incoming().technicianEmail == callerEmail()
          )
        );
      allow update: if isValidId(readingId)
        && (isAdmin() || (isSupervisor() && callerEmail() in existing().supervisorEmails && callerEmail() in incoming().supervisorEmails))
        && isValidUtilityReading(incoming())
        && incoming().id == existing().id
        && incoming().buildingId == existing().buildingId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'readingDate', 'readingValue', 'notes',
          'technicianUid', 'technicianName', 'technicianEmail',
          'supervisorEmails', 'buildingMemberEmails', 'updatedAt'
        ]);
      allow delete: if isValidId(readingId) && (
        isAdmin()
        || (isSupervisor() && callerEmail() in existing().supervisorEmails)
      );
    }

    match /tenant_schedules/{scheduleId} {
      allow get: if isValidId(scheduleId) && (
        isAdmin()
        || (isSupervisor() && callerEmail() in existing().supervisorEmails)
        || (isAuthIdentity() && (existing().assignedTechEmail == callerEmail() || existing().assignedTechUid == request.auth.uid))
      );
      allow list: if isRootAdminEmail()
        || (isAuthIdentity() && (
          callerEmail() in resource.data.supervisorEmails
          || resource.data.assignedTechEmail == callerEmail()
          || resource.data.assignedTechUid == request.auth.uid
        ));
      allow create: if isValidId(scheduleId)
        && isAuthIdentity()
        && isValidTenantSchedule(incoming())
        && incoming().id == scheduleId
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/buildings/$(incoming().buildingId))
        && (
          isAdmin()
          || (isSupervisor() && ownsBuildingDoc(incoming().buildingId))
          || (
            isTechnician()
            && isBuildingMemberDoc(incoming().buildingId)
            && incoming().assignedTechEmail == callerEmail()
          )
        );
      allow update: if isValidId(scheduleId)
        && isAuthIdentity()
        && isValidTenantSchedule(incoming())
        && incoming().id == existing().id
        && incoming().buildingId == existing().buildingId
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            (isAdmin() || (isSupervisor() && callerEmail() in existing().supervisorEmails && callerEmail() in incoming().supervisorEmails))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'scheduleDate', 'timeSlot', 'unitOrLocation', 'tenantName',
              'category', 'description', 'assignedTechUid', 'assignedTechName',
              'assignedTechEmail', 'status', 'completionNotes',
              'supervisorEmails', 'buildingMemberEmails', 'updatedAt'
            ])
          )
          ||
          (
            isTechnician()
            && (existing().assignedTechEmail == callerEmail() || existing().assignedTechUid == request.auth.uid)
            && existing().status in ['Pending', 'In Progress']
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'completionNotes', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(scheduleId) && (
        isAdmin()
        || (isSupervisor() && callerEmail() in existing().supervisorEmails)
      );
    }

    match /maintenance_notifications/{notificationId} {
      allow get: if isValidId(notificationId) && (
        isAdmin()
        || (isSupervisor() && callerEmail() in existing().supervisorEmails)
        || (isAuthIdentity() && callerEmail() in existing().buildingMemberEmails)
      );
      allow list: if isRootAdminEmail()
        || (isAuthIdentity() && (
          callerEmail() in resource.data.supervisorEmails
          || callerEmail() in resource.data.buildingMemberEmails
        ));
      allow create: if isValidId(notificationId)
        && isSupervisor()
        && isValidMaintenanceNotification(incoming())
        && incoming().id == notificationId
        && incoming().createdByUid == request.auth.uid
        && incoming().createdByEmail == callerEmail()
        && incoming().status == 'active'
        && incoming().acknowledgedByEmails.size() == 0
        && incoming().resolvedByName == ''
        && incoming().resolvedAtIso == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/buildings/$(incoming().buildingId))
        && (isAdmin() || ownsBuildingDoc(incoming().buildingId));
      allow update: if isValidId(notificationId)
        && isAuthIdentity()
        && isValidMaintenanceNotification(incoming())
        && incoming().id == existing().id
        && incoming().buildingId == existing().buildingId
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdByEmail == existing().createdByEmail
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            (isAdmin() || (isSupervisor() && callerEmail() in existing().supervisorEmails))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'buildingCode', 'buildingName', 'severity', 'category', 'title',
              'message', 'locationZone', 'status', 'resolvedByName', 'resolvedAtIso',
              'expiresAtDate', 'supervisorEmails', 'buildingMemberEmails', 'updatedAt'
            ])
          )
          ||
          (
            (
              isAdmin()
              || (isSupervisor() && callerEmail() in existing().supervisorEmails)
              || (isTechnician() && callerEmail() in existing().buildingMemberEmails)
            )
            && existing().status == 'active'
            && incoming().diff(existing()).affectedKeys().hasOnly(['acknowledgedByEmails', 'updatedAt'])
            && incoming().acknowledgedByEmails.hasAll(existing().acknowledgedByEmails)
            && incoming().acknowledgedByEmails.toSet().difference(existing().acknowledgedByEmails.toSet()).hasOnly([callerEmail()])
          )
        );
      allow delete: if isValidId(notificationId) && (
        isAdmin()
        || (isSupervisor() && callerEmail() in existing().supervisorEmails)
      );
    }
  }
}
